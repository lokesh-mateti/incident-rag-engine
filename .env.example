# LLM Provider: "openrouter" (default) or "anthropic"
LLM_PROVIDER=openrouter

# OpenRouter (default) — get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# Anthropic (direct) — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Shared
LLM_MAX_TOKENS=2048
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=incidents
EMBEDDING_MODEL=all-MiniLM-L6-v2
INCIDENT_DATA_DIR=./data/incidents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
LOG_LEVEL=INFO
